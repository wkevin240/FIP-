POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fip_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fip_db
# Réservés au rôle de migration, distinct du rôle applicatif.
POSTGRES_MIGRATION_USER=fip_migrator
POSTGRES_MIGRATION_PASSWORD=change-me
# Secret aléatoire dédié à l’autorisation PostgreSQL de comptabilisation.
ACCOUNTING_POSTING_TOKEN=replace-with-a-long-random-secret
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=["http://localhost:3000"]
